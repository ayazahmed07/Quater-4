# Whapi.cloud API Configuration
WHAPI_API_URL=https://gate.whapi.cloud
WHAPI_API_TOKEN=your_token_here
WHAPI_RECIPIENT_NUMBER=your_phone_number

# Scraping Configuration
# Default news URL: https://jang.com.pk/category/latest-news
NEWS_URL=https://jang.com.pk/category/latest-news
SCRAPE_INTERVAL_SECONDS=300

# Storage and Logging
DATABASE_FILE=storage/database.json
LOG_FILE=logs/jang_news_agent.log
